# Copy this file to .env and fill in real values. Never commit the real
# .env to the (public, required-by-the-hackathon) repo.

# --- Google Cloud / Vertex AI (Gemini via Agent Builder / Agent Engine) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# ^ TRUE means auth via Application Default Credentials (gcloud auth
#   application-default login, or the deployed service account) — no raw
#   API key needed. This is the enterprise-security-correct path; it's
#   also what removes G6's "No API key was provided" failure.

# --- Grafana Cloud MCP (partner track requirement) ---
# PREFERRED (headless, deterministic, no browser): the official OSS
# `grafana/mcp-grafana` server over stdio with a SERVICE-ACCOUNT TOKEN.
#   1. Download the binary → services/agent/bin/mcp-grafana[.exe] (auto-detected;
#      override with MCP_GRAFANA_BIN). Docker/Helm/PATH installs work too.
#   2. In your stack: Administration → Users and access → Service accounts →
#      Add service account (role: Editor) → Add token → copy the glsa_... value.
#   3. Set both of these:
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_token_here
# FALLBACK (interactive): leave the token blank and set GRAFANA_STACK_URL to use
# the hosted mcp.grafana.com OAuth endpoint (opens a browser once; needs an ADK
# build that performs the MCP OAuth 2.1 handshake, and the "Grafana Assistant"
# terms accepted once by a stack admin).
# GRAFANA_STACK_URL=https://your-stack.grafana.net
# MCP_GRAFANA_BIN=

# --- Radar deterministic gates ---
SCENELOCK_LOOP_BUDGET_CAP=2

# --- (optional) Single source of truth: defer the deterministic gates to
#     the running TypeScript backend instead of the offline reference impl.
#     When set, regenerate_shot_within_budget / sign_certificate_if_locked
#     call the TS API (services/api), which owns the ONE implementation of
#     the budget cap and the lock rule (spec D5). Leave unset for offline.
# SCENELOCK_API_BASE=http://localhost:4000
