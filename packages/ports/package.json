{
  "name": "@scenelock/ports",
  "version": "0.1.0",
  "description": "Adapter seam (decision: local now, cloud later). Port interfaces + in-memory adapters for storage, events, clock, ids. Firestore/Pub-Sub adapters implement the same interfaces in a later phase.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@scenelock/schema": "workspace:*",
    "@scenelock/fixtures": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
