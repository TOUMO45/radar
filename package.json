{
  "name": "radar",
  "private": true,
  "version": "0.1.0",
  "description": "Radar — closed-loop QA radar for AI-generated film content",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "seed:verdict": "pnpm --filter @scenelock/api exec tsx src/scripts/print-verdict.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  }
}
